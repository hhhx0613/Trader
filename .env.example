# ==================== 数据源 API Keys ====================

# Finnhub API Key (免费申请: https://finnhub.io/register)
FINNHUB_API_KEY=your_finnhub_key_here

# Alpha Vantage API Key (免费申请: https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=your_api_key_here

# ==================== LLM API Keys ====================
# 推荐：将 Key 配置在系统环境变量中（更安全，不随代码提交）
# 方式 1（推荐）：系统环境变量
#   Windows: setx GLM_API_KEY "your_key_here"
#   Linux/Mac: export GLM_API_KEY="your_key_here"
#
# 方式 2：在 .env 文件中设置（会覆盖系统环境变量）
# 取消下面的注释并填入真实 Key

# OpenAI API Key (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=

# GLM (智谱 AI) API Key (https://open.bigmodel.cn/usercenter/apikeys)
# GLM_API_KEY=

# DeepSeek API Key (https://platform.deepseek.com/api_keys)
# DEEPSEEK_API_KEY=

# ==================== LLM 配置 ====================

# 默认使用的 LLM 提供商: openai | glm | deepseek
DEFAULT_LLM_PROVIDER=openai

# ==================== 其他配置 ====================

# IBKR 端口 (IB Gateway 默认 4002, TWS 默认 7497)
IBKR_PORT=4002
